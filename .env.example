# SecureWipe cloud services. Copy to .env and replace every sample value.
# Do not commit .env. Configure identical private service values for API and worker.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://securewipe:replace-me@postgres:5432/securewipe
REDIS_URL=redis://redis:6379/0

# Optional. If set, a short text sample is sent to OpenAI from the backend.
OPENAI_API_KEY=

# Private AWS S3 bucket; keep public access blocked. Configure bucket CORS for your frontend origin.
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=securewipe-private
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

VERIFY_BASE_URL=http://localhost:3000
CERTIFICATE_PRIVATE_KEY=""
PUBLIC_VERIFICATION_KEY=""
JWT_SECRET=replace-with-at-least-32-random-bytes
UPLOAD_MAX_BYTES=26214400
RETENTION_HOURS=24
ALLOWED_ORIGINS=http://localhost:3000

# Used by web/.env.local and Vercel. These are public URLs, never secrets.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
